{"id":"sancti-11-02.m3.sequence.4","type":"stanza","kind":"hymn","t":{"la":["Mors stupébit et natúra,",{"br":1},"Cum resúrget creatúra,",{"br":1},"Judicánti responsúra."]}}
{"id":"sancti-11-02.m3.sequence.5","type":"stanza","kind":"hymn","t":{"la":["Liber scriptus proferétur,",{"br":1},"In quo totum continétur,",{"br":1},"Unde mundus judicétur."]}}
