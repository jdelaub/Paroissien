{"id":"sancti-11-02.m3.sequence.2","type":"stanza","kind":"hymn","t":{"la":["Quantus tremor est futúrus,",{"br":1},"Quando judex est ventúrus,",{"br":1},"Cuncta stricte discussúrus!"]}}
