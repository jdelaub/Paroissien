{"id":"sancti-11-02.m3.sequence.7","type":"stanza","kind":"hymn","t":{"la":["Quid sum miser tunc dictúrus?",{"br":1},"Quem patrónum rogatúrus,",{"br":1},"Cum vix justus sit secúrus?"]}}
{"id":"sancti-11-02.m3.sequence.8","type":"stanza","kind":"hymn","t":{"la":["Rex treméndæ majestátis,",{"br":1},"Qui salvándos salvas gratis,",{"br":1},"Salva me, fons pietátis."]}}
{"id":"sancti-11-02.m3.sequence.9","type":"stanza","kind":"hymn","t":{"la":["Recordáre, Jesu pie,",{"br":1},"Quod sum causa tuæ viæ:",{"br":1},"Ne me perdas illa die."]}}
{"id":"sancti-11-02.m3.sequence.10","type":"stanza","kind":"hymn","t":{"la":["Quærens me, sedísti lassus:",{"br":1},"Redemísti Crucem passus:",{"br":1},"Tantus labor non sit cassus."]}}
