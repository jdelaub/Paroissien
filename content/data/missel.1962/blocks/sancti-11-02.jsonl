{"id":"sancti-11-02.m3.sequence.12","type":"stanza","kind":"hymn","t":{"la":["Ingemísco, tamquam reus:",{"br":1},"Culpa rubet vultus meus:",{"br":1},"Supplicánti parce, Deus."]}}
