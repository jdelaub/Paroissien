{"id":"sancti-11-02.m3.sequence.17","type":"stanza","kind":"hymn","t":{"la":["Oro supplex et acclínis,",{"br":1},"Cor contrítum quasi cinis:",{"br":1},"Gere curam mei finis."]}}
