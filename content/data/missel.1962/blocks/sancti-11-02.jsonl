{"id":"sancti-11-02.m3.graduel.3","type":"rubric","t":{"la":["Ps 111:7."],"fr":["Ps 111:7."]}}
{"id":"sancti-11-02.m3.graduel.4","type":"versicle","role":"V","t":{"la":[{"sym":"V"}," ","In memória ætérna erit justus: ab auditióne mala non timébit."]}}
{"id":"sancti-11-02.m3.graduel.5","type":"rubric","t":{"la":["Tractus"],"fr":["Trait"]}}
{"id":"sancti-11-02.m3.graduel.6","type":"para","t":{"la":["Absólve, Dómine, ánimas ómnium fidélium ab omni vínculo delictórum."]}}
{"id":"sancti-11-02.m3.graduel.7","type":"versicle","role":"V","t":{"la":[{"sym":"V"}," ","Et grátia tua illis succurrénte, mereántur evádere judícium ultiónis."]}}
{"id":"sancti-11-02.m3.graduel.8","type":"versicle","role":"V","t":{"la":[{"sym":"V"}," ","Et lucis ætérnæ beatitúdine pérfrui."]}}
