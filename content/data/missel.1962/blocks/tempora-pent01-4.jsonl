{"id":"tempora-pent01-4.offertoire","type":"heading","level":2,"x-source":[{"file":"missa/Latin/Tempora/Pent01-4.txt","section":"Offertorium"}],"t":{"la":["Offertorium"],"fr":["Offertoire"]}}
