{"id":"oba.titre","type":"heading","level":1,"t":{"la":["Prophetia Abdiæ"]}}
{"id":"oba.1","type":"heading","level":2,"label":"Caput 1","t":{"la":["Caput 1"]}}
{"id":"oba.1.1","type":"verse","n":"1","p":true,"dropCap":true,"t":{"la":[{"num":"1"},"Visio Abdiæ. Hæc dicit Dominus Deus ad Edom :",{"br":1},"Auditum audivimus a Domino,",{"br":1},"et legatum ad gentes misit :",{"br":1},"surgite, et consurgamus adversus eum in prælium.",{"br":1}]}}
{"id":"oba.1.2","type":"verse","n":"2","t":{"la":[{"num":"2"},"Ecce parvulum dedi te in gentibus :",{"br":1},"contemptibilis tu es valde.",{"br":1}]}}
{"id":"oba.1.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Superbia cordis tui extulit te,",{"br":1},"habitantem in scissuris petrarum,",{"br":1},"exaltantem solium tuum ;",{"br":1},"qui dicis in corde tuo :",{"br":1},"Quis detrahet me in terram ?",{"br":1}]}}
{"id":"oba.1.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Si exaltatus fueris ut aquila,",{"br":1},"et si inter sidera posueris nidum tuum,",{"br":1},"inde detraham te, dicit Dominus.",{"br":1}]}}
{"id":"oba.1.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Si fures introissent ad te,",{"br":1},"si latrones per noctem,",{"br":1},"quomodo conticuisses ?",{"br":1},"nonne furati essent sufficientia sibi ?",{"br":1},"Si vindemiatores introissent ad te,",{"br":1},"numquid saltem racemum reliquissent tibi ?",{"br":1}]}}
{"id":"oba.1.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Quomodo scrutati sunt Esau ;",{"br":1},"investigaverunt abscondita ejus ?",{"br":1}]}}
{"id":"oba.1.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Usque ad terminum emiserunt te :",{"br":1},"omnes viri fœderis tui illuserunt tibi :",{"br":1},"invaluerunt adversum te viri pacis tuæ,",{"br":1},"qui comedunt tecum, ponent insidias subter te ;",{"br":1},"non est prudentia in eo.",{"br":1}]}}
{"id":"oba.1.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Numquid non in die illa, dicit Dominus,",{"br":1},"perdam sapientes de Idumæa,",{"br":1},"et prudentiam de monte Esau ?",{"br":1}]}}
{"id":"oba.1.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Et timebunt fortes tui a meridie,",{"br":1},"ut intereat vir de monte Esau.",{"br":1}]}}
{"id":"oba.1.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Propter interfectionem,",{"br":1},"et propter iniquitatem in fratrem tuum Jacob,",{"br":1},"operiet te confusio, et peribis in æternum.",{"br":1}]}}
{"id":"oba.1.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"In die cum stares adversus eum,",{"br":1},"quando capiebant alieni exercitum ejus,",{"br":1},"et extranei ingrediebantur portas ejus,",{"br":1},"et super Jerusalem mittebant sortem,",{"br":1},"tu quoque eras quasi unus ex eis.",{"br":1}]}}
{"id":"oba.1.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"Et non despicies in die fratris tui,",{"br":1},"in die peregrinationis ejus :",{"br":1},"et non lætaberis super filios Juda",{"br":1},"in die perditionis eorum :",{"br":1},"et non magnificabis os tuum",{"br":1},"in die angustiæ.",{"br":1}]}}
{"id":"oba.1.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Neque ingredieris portam populi mei",{"br":1},"in die ruinæ eorum ;",{"br":1},"neque despicies et tu in malis ejus",{"br":1},"in die vastitatis illius.",{"br":1},"Et non emitteris adversus exercitum ejus",{"br":1},"in die vastitatis illius,",{"br":1}]}}
{"id":"oba.1.14","type":"verse","n":"14","t":{"la":[{"num":"14"},"neque stabis in exitibus",{"br":1},"ut interficias eos qui fugerint,",{"br":1},"et non concludes reliquos ejus",{"br":1},"in die tribulationis.",{"br":1}]}}
{"id":"oba.1.15","type":"verse","n":"15","t":{"la":[{"num":"15"},"Quoniam juxta est dies Domini super omnes gentes :",{"br":1},"sicut fecisti, fiet tibi ;",{"br":1},"retributionem tuam convertet in caput tuum.",{"br":1}]}}
{"id":"oba.1.16","type":"verse","n":"16","t":{"la":[{"num":"16"},"Quomodo enim bibistis super montem sanctum meum,",{"br":1},"bibent omnes gentes jugiter :",{"br":1},"et bibent, et absorbebunt,",{"br":1},"et erunt quasi non sint."]}}
{"id":"oba.1.17","type":"verse","n":"17","p":true,"t":{"la":[{"num":"17"},"Et in monte Sion erit salvatio, et erit sanctus ;",{"br":1},"et possidebit domus Jacob eos qui se possederant.",{"br":1}]}}
{"id":"oba.1.18","type":"verse","n":"18","t":{"la":[{"num":"18"},"Et erit domus Jacob ignis,",{"br":1},"et domus Joseph flamma,",{"br":1},"et domus Esau stipula :",{"br":1},"et succendentur in eis, et devorabunt eos,",{"br":1},"et non erunt reliquiæ domus Esau,",{"br":1},"quia Dominus locutus est.",{"br":1}]}}
{"id":"oba.1.19","type":"verse","n":"19","t":{"la":[{"num":"19"},"Et hæreditabunt hi, qui ad austrum sunt, montem Esau,",{"br":1},"et qui in campestribus, Philisthiim :",{"br":1},"et possidebunt regionem Ephraim et regionem Samariæ,",{"br":1},"et Benjamin possidebit Galaad.",{"br":1}]}}
{"id":"oba.1.20","type":"verse","n":"20","t":{"la":[{"num":"20"},"Et transmigratio exercitus hujus filiorum Israël,",{"br":1},"omnia loca Chananæorum usque ad Sareptam :",{"br":1},"et transmigratio Jerusalem, quæ in Bosphoro est,",{"br":1},"possidebit civitates austri.",{"br":1}]}}
{"id":"oba.1.21","type":"verse","n":"21","t":{"la":[{"num":"21"},"Et ascendent salvatores in montem Sion judicare montem Esau,",{"br":1},"et erit Domino regnum."]}}
