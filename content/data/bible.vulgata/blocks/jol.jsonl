{"id":"jol.titre","type":"heading","level":1,"t":{"la":["Prophetia Joel"]}}
{"id":"jol.1","type":"heading","level":2,"label":"Caput 1","t":{"la":["Caput 1"]}}
{"id":"jol.1.1","type":"verse","n":"1","p":true,"dropCap":true,"t":{"la":[{"num":"1"},"Verbum Domini, quod factum est ad Joël, filium Phatuel."]}}
{"id":"jol.1.2","type":"verse","n":"2","t":{"la":[{"num":"2"},"Audite hoc, senes,",{"br":1},"et auribus percipite, omnes habitatores terræ :",{"br":1},"si factum est istud in diebus vestris,",{"br":1},"aut in diebus patrum vestrorum ?",{"br":1}]}}
{"id":"jol.1.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Super hoc filiis vestris narrate,",{"br":1},"et filii vestri filiis suis,",{"br":1},"et filii eorum generationi alteræ.",{"br":1}]}}
{"id":"jol.1.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Residuum erucæ comedit locusta,",{"br":1},"et residuum locustæ comedit bruchus,",{"br":1},"et residuum bruchi comedit rubigo.",{"br":1}]}}
{"id":"jol.1.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Expergiscimini, ebrii,",{"br":1},"et flete et ululate, omnes qui bibitis vinum in dulcedine,",{"br":1},"quoniam periit ab ore vestro.",{"br":1}]}}
{"id":"jol.1.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Gens enim ascendit super terram meam,",{"br":1},"fortis et innumerabilis :",{"br":1},"dentes ejus ut dentes leonis,",{"br":1},"et molares ejus ut catuli leonis.",{"br":1}]}}
{"id":"jol.1.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Posuit vineam meam in desertum,",{"br":1},"et ficum meam decorticavit ;",{"br":1},"nudans spoliavit eam, et projecit :",{"br":1},"albi facti sunt rami ejus.",{"br":1}]}}
{"id":"jol.1.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Plange quasi virgo accincta sacco super virum pubertatis suæ.",{"br":1}]}}
{"id":"jol.1.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Periit sacrificium et libatio de domo Domini ;",{"br":1},"luxerunt sacerdotes, ministri Domini.",{"br":1}]}}
{"id":"jol.1.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Depopulata est regio,",{"br":1},"luxit humus,",{"br":1},"quoniam devastatum est triticum,",{"br":1},"confusum est vinum,",{"br":1},"elanguit oleum.",{"br":1}]}}
{"id":"jol.1.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Confusi sunt agricolæ,",{"br":1},"ululaverunt vinitores",{"br":1},"super frumento et hordeo,",{"br":1},"quia periit messis agri.",{"br":1}]}}
{"id":"jol.1.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"Vinea confusa est,",{"br":1},"et ficus elanguit ;",{"br":1},"malogranatum, et palma, et malum,",{"br":1},"et omnia ligna agri aruerunt,",{"br":1},"quia confusum est gaudium a filiis hominum.",{"br":1}]}}
{"id":"jol.1.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Accingite vos, et plangite, sacerdotes :",{"br":1},"ululate, ministri altaris ;",{"br":1},"ingredimini, cubate in sacco, ministri Dei mei,",{"br":1},"quoniam interiit de domo Dei vestri sacrificium et libatio.",{"br":1}]}}
{"id":"jol.1.14","type":"verse","n":"14","t":{"la":[{"num":"14"},"Sanctificate jejunium, vocate cœtum,",{"br":1},"congregate senes, omnes habitatores terræ",{"br":1},"in domum Dei vestri,",{"br":1},"et clamate ad Dominum :",{"br":1}]}}
{"id":"jol.1.15","type":"verse","n":"15","t":{"la":[{"num":"15"},"A, a, a, diei !",{"br":1},"quia prope est dies Domini,",{"br":1},"et quasi vastitas a potente veniet.",{"br":1}]}}
{"id":"jol.1.16","type":"verse","n":"16","t":{"la":[{"num":"16"},"Numquid non coram oculis vestris alimenta perierunt",{"br":1},"de domo Dei nostri, lætitia et exsultatio ?",{"br":1}]}}
{"id":"jol.1.17","type":"verse","n":"17","t":{"la":[{"num":"17"},"Computruerunt jumenta in stercore suo,",{"br":1},"demolita sunt horrea,",{"br":1},"dissipatæ sunt apothecæ,",{"br":1},"quoniam confusum est triticum.",{"br":1}]}}
{"id":"jol.1.18","type":"verse","n":"18","t":{"la":[{"num":"18"},"Quid ingemuit animal,",{"br":1},"mugierunt greges armenti ?",{"br":1},"quia non est pascua eis ;",{"br":1},"sed et greges pecorum disperierunt.",{"br":1}]}}
{"id":"jol.1.19","type":"verse","n":"19","t":{"la":[{"num":"19"},"Ad te, Domine, clamabo,",{"br":1},"quia ignis comedit speciosa deserti,",{"br":1},"et flamma succendit omnia ligna regionis.",{"br":1}]}}
{"id":"jol.1.20","type":"verse","n":"20","t":{"la":[{"num":"20"},"Sed et bestiæ agri, quasi area sitiens imbrem, suspexerunt ad te,",{"br":1},"quoniam exsiccati sunt fontes aquarum,",{"br":1},"et ignis devoravit speciosa deserti."]}}
{"id":"jol.2","type":"heading","level":2,"label":"Caput 2","t":{"la":["Caput 2"]}}
{"id":"jol.2.1","type":"verse","n":"1","p":true,"t":{"la":[{"num":"1"},"Canite tuba in Sion,",{"br":1},"ululate in monte sancto meo,",{"br":1},"conturbentur omnes habitatores terræ :",{"br":1},"quia venit dies Domini, quia prope est.",{"br":1}]}}
{"id":"jol.2.2","type":"verse","n":"2","t":{"la":[{"num":"2"},"Dies tenebrarum et caliginis,",{"br":1},"dies nubis et turbinis ;",{"br":1},"quasi mane expansum super montes",{"br":1},"populus multus et fortis :",{"br":1},"similis ei non fuit a principio,",{"br":1},"et post eum non erit",{"br":1},"usque in annos generationis et generationis.",{"br":1}]}}
{"id":"jol.2.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Ante faciem ejus ignis vorans,",{"br":1},"et post eum exurens flamma.",{"br":1},"Quasi hortus voluptatis terra coram eo,",{"br":1},"et post eum solitudo deserti,",{"br":1},"neque est qui effugiat eum.",{"br":1}]}}
{"id":"jol.2.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Quasi aspectus equorum, aspectus eorum ;",{"br":1},"et quasi equites, sic current.",{"br":1}]}}
{"id":"jol.2.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Sicut sonitus quadrigarum super capita montium exilient,",{"br":1},"sicut sonitus flammæ ignis devorantis stipulam,",{"br":1},"velut populus fortis præparatus ad prælium.",{"br":1}]}}
{"id":"jol.2.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"A facie ejus cruciabuntur populi ;",{"br":1},"omnes vultus redigentur in ollam.",{"br":1}]}}
{"id":"jol.2.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Sicut fortes current ;",{"br":1},"quasi viri bellatores ascendent murum :",{"br":1},"viri in viis suis gradientur,",{"br":1},"et non declinabunt a semitis suis.",{"br":1}]}}
{"id":"jol.2.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Unusquisque fratrem suum non coarctabit,",{"br":1},"singuli in calle suo ambulabunt ;",{"br":1},"sed et per fenestras cadent, et non demolientur.",{"br":1}]}}
{"id":"jol.2.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Urbem ingredientur, in muro current,",{"br":1},"domos conscendent, per fenestras intrabunt quasi fur.",{"br":1}]}}
{"id":"jol.2.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"A facie ejus contremuit terra,",{"br":1},"moti sunt cæli,",{"br":1},"sol et luna obtenebrati sunt,",{"br":1},"et stellæ retraxerunt splendorem suum.",{"br":1}]}}
{"id":"jol.2.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Et Dominus dedit vocem suam ante faciem exercitus sui,",{"br":1},"quia multa sunt nimis castra ejus,",{"br":1},"quia fortia et facientia verbum ejus :",{"br":1},"magnus enim dies Domini, et terribilis valde,",{"br":1},"et quis sustinebit eum ?",{"br":1}]}}
{"id":"jol.2.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"Nunc ergo, dicit Dominus,",{"br":1},"convertimini ad me in toto corde vestro,",{"br":1},"in jejunio, et in fletu, et in planctu.",{"br":1}]}}
{"id":"jol.2.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Et scindite corda vestra, et non vestimenta vestra ;",{"br":1},"et convertimini ad Dominum Deum vestrum,",{"br":1},"quia benignus et misericors est,",{"br":1},"patiens et multæ misericordiæ,",{"br":1},"et præstabilis super malitia.",{"br":1}]}}
{"id":"jol.2.14","type":"verse","n":"14","t":{"la":[{"num":"14"},"Quis scit si convertatur, et ignoscat,",{"br":1},"et relinquat post se benedictionem, sacrificium et libamen Domino Deo vestro ?",{"br":1}]}}
{"id":"jol.2.15","type":"verse","n":"15","t":{"la":[{"num":"15"},"Canite tuba in Sion,",{"br":1},"sanctificate jejunium, vocate cœtum :",{"br":1}]}}
{"id":"jol.2.16","type":"verse","n":"16","t":{"la":[{"num":"16"},"congregate populum, sanctificate ecclesiam,",{"br":1},"coadunate senes, congregate parvulos, et sugentes ubera ;",{"br":1},"egrediatur sponsus de cubili suo,",{"br":1},"et sponsa de thalamo suo.",{"br":1}]}}
{"id":"jol.2.17","type":"verse","n":"17","t":{"la":[{"num":"17"},"Inter vestibulum et altare plorabunt sacerdotes, ministri Domini,",{"br":1},"et dicent : Parce, Domine, parce populo tuo ;",{"br":1},"et ne des hæreditatem tuam in opprobrium,",{"br":1},"ut dominentur eis nationes.",{"br":1},"Quare dicunt in populis : Ubi est Deus eorum ?"]}}
{"id":"jol.2.18","type":"verse","n":"18","p":true,"t":{"la":[{"num":"18"},"Zelatus est Dominus terram suam,",{"br":1},"et pepercit populo suo.",{"br":1}]}}
{"id":"jol.2.19","type":"verse","n":"19","t":{"la":[{"num":"19"},"Et respondit Dominus, et dixit populo suo :",{"br":1},"Ecce ego mittam vobis frumentum, et vinum, et oleum,",{"br":1},"et replebimini eis ;",{"br":1},"et non dabo vos ultra opprobrium in gentibus.",{"br":1}]}}
{"id":"jol.2.20","type":"verse","n":"20","t":{"la":[{"num":"20"},"Et eum qui ab aquilone est procul faciam a vobis,",{"br":1},"et expellam eum in terram inviam et desertam :",{"br":1},"faciem ejus contra mare orientale,",{"br":1},"et extremum ejus ad mare novissimum :",{"br":1},"et ascendet fœtor ejus,",{"br":1},"et ascendet putredo ejus,",{"br":1},"quia superbe egit.",{"br":1}]}}
{"id":"jol.2.21","type":"verse","n":"21","t":{"la":[{"num":"21"},"Noli timere, terra :",{"br":1},"exsulta, et lætare,",{"br":1},"quoniam magnificavit Dominus ut faceret.",{"br":1}]}}
{"id":"jol.2.22","type":"verse","n":"22","t":{"la":[{"num":"22"},"Nolite timere, animalia regionis,",{"br":1},"quia germinaverunt speciosa deserti ;",{"br":1},"quia lignum attulit fructum suum,",{"br":1},"ficus et vinea dederunt virtutem suam.",{"br":1}]}}
{"id":"jol.2.23","type":"verse","n":"23","t":{"la":[{"num":"23"},"Et, filii Sion, exsultate,",{"br":1},"et lætamini in Domino Deo vestro,",{"br":1},"quia dedit vobis doctorem justitiæ,",{"br":1},"et descendere faciet ad vos imbrem matutinum et serotinum,",{"br":1},"sicut in principio.",{"br":1}]}}
{"id":"jol.2.24","type":"verse","n":"24","t":{"la":[{"num":"24"},"Et implebuntur areæ frumento,",{"br":1},"et redundabunt torcularia vino et oleo.",{"br":1}]}}
{"id":"jol.2.25","type":"verse","n":"25","t":{"la":[{"num":"25"},"Et reddam vobis annos, quos comedit locusta,",{"br":1},"bruchus, et rubigo, et eruca :",{"br":1},"fortitudo mea magna quam misi in vos.",{"br":1}]}}
{"id":"jol.2.26","type":"verse","n":"26","t":{"la":[{"num":"26"},"Et comedetis vescentes, et saturabimini ;",{"br":1},"et laudabitis nomen Domini Dei vestri,",{"br":1},"qui fecit mirabilia vobiscum ;",{"br":1},"et non confundetur populus meus in sempiternum.",{"br":1}]}}
{"id":"jol.2.27","type":"verse","n":"27","t":{"la":[{"num":"27"},"Et scietis quia in medio Israël ego sum,",{"br":1},"et ego Dominus Deus vester, et non est amplius ;",{"br":1},"et non confundetur populus meus in æternum."]}}
{"id":"jol.2.28","type":"verse","n":"28","p":true,"t":{"la":[{"num":"28"},"Et erit post hæc :",{"br":1},"effundam spiritum meum super omnem carnem,",{"br":1},"et prophetabunt filii vestri et filiæ vestræ :",{"br":1},"senes vestri somnia somniabunt,",{"br":1},"et juvenes vestri visiones videbunt.",{"br":1}]}}
{"id":"jol.2.29","type":"verse","n":"29","t":{"la":[{"num":"29"},"Sed et super servos meos et ancillas",{"br":1},"in diebus illis effundam spiritum meum.",{"br":1}]}}
{"id":"jol.2.30","type":"verse","n":"30","t":{"la":[{"num":"30"},"Et dabo prodigia in cælo et in terra,",{"br":1},"sanguinem, et ignem, et vaporem fumi.",{"br":1}]}}
{"id":"jol.2.31","type":"verse","n":"31","t":{"la":[{"num":"31"},"Sol convertetur in tenebras,",{"br":1},"et luna in sanguinem,",{"br":1},"antequam veniat dies Domini magnus et horribilis.",{"br":1}]}}
{"id":"jol.2.32","type":"verse","n":"32","t":{"la":[{"num":"32"},"Et erit : omnis qui invocaverit nomen Domini, salvus erit :",{"br":1},"quia in monte Sion et in Jerusalem",{"br":1},"erit salvatio, sicut dixit Dominus,",{"br":1},"et in residuis quos Dominus vocaverit."]}}
{"id":"jol.3","type":"heading","level":2,"label":"Caput 3","t":{"la":["Caput 3"]}}
{"id":"jol.3.1","type":"verse","n":"1","p":true,"t":{"la":[{"num":"1"},"Quia ecce in diebus illis, et in tempore illo,",{"br":1},"cum convertero captivitatem Juda et Jerusalem,",{"br":1}]}}
{"id":"jol.3.2","type":"verse","n":"2","t":{"la":[{"num":"2"},"congregabo omnes gentes,",{"br":1},"et deducam eas in vallem Josaphat ;",{"br":1},"et disceptabo cum eis ibi super populo meo,",{"br":1},"et hæreditate mea Israël,",{"br":1},"quos disperserunt in nationibus,",{"br":1},"et terram meam diviserunt.",{"br":1}]}}
{"id":"jol.3.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Et super populum meum miserunt sortem ;",{"br":1},"et posuerunt puerum in prostibulo,",{"br":1},"et puellam vendiderunt pro vino ut biberent.",{"br":1}]}}
{"id":"jol.3.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Verum quid mihi et vobis, Tyrus et Sidon,",{"br":1},"et omnis terminus Palæstinorum ?",{"br":1},"numquid ultionem vos reddetis mihi ?",{"br":1},"et si ulciscimini vos contra me,",{"br":1},"cito velociter reddam vicissitudinem vobis super caput vestrum.",{"br":1}]}}
{"id":"jol.3.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Argentum enim meum et aurum tulistis,",{"br":1},"et desiderabilia mea et pulcherrima intulistis in delubra vestra.",{"br":1}]}}
{"id":"jol.3.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Et filios Juda et filios Jerusalem vendidistis filiis Græcorum,",{"br":1},"ut longe faceretis eos de finibus suis.",{"br":1}]}}
{"id":"jol.3.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Ecce ego suscitabo eos de loco in quo vendidistis eos,",{"br":1},"et convertam retributionem vestram in caput vestrum.",{"br":1}]}}
{"id":"jol.3.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Et vendam filios vestros et filias vestras in manibus filiorum Juda,",{"br":1},"et venundabunt eos Sabæis, genti longinquæ,",{"br":1},"quia Dominus locutus est.",{"br":1}]}}
{"id":"jol.3.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Clamate hoc in gentibus,",{"br":1},"sanctificate bellum,",{"br":1},"suscitate robustos :",{"br":1},"accedant, ascendant omnes viri bellatores.",{"br":1}]}}
{"id":"jol.3.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Concidite aratra vestra in gladios,",{"br":1},"et ligones vestros in lanceas.",{"br":1},"Infirmus dicat : Quia fortis ego sum.",{"br":1}]}}
{"id":"jol.3.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Erumpite, et venite, omnes gentes de circuitu,",{"br":1},"et congregamini ;",{"br":1},"ibi occumbere faciet Dominus robustos tuos.",{"br":1}]}}
{"id":"jol.3.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"Consurgant, et ascendant gentes in vallem Josaphat,",{"br":1},"quia ibi sedebo ut judicem omnes gentes in circuitu.",{"br":1}]}}
{"id":"jol.3.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Mittite falces, quoniam maturavit messis ;",{"br":1},"venite, et descendite,",{"br":1},"quia plenum est torcular, exuberant torcularia :",{"br":1},"quia multiplicata est malitia eorum.",{"br":1}]}}
{"id":"jol.3.14","type":"verse","n":"14","t":{"la":[{"num":"14"},"Populi, populi, in valle concisionis,",{"br":1},"quia juxta est dies Domini in valle concisionis.",{"br":1}]}}
{"id":"jol.3.15","type":"verse","n":"15","t":{"la":[{"num":"15"},"Sol et luna obtenebrati sunt,",{"br":1},"et stellæ retraxerunt splendorem suum.",{"br":1}]}}
{"id":"jol.3.16","type":"verse","n":"16","t":{"la":[{"num":"16"},"Et Dominus de Sion rugiet,",{"br":1},"et de Jerusalem dabit vocem suam,",{"br":1},"et movebuntur cæli et terra ;",{"br":1},"et Dominus spes populi sui,",{"br":1},"et fortitudo filiorum Israël.",{"br":1}]}}
{"id":"jol.3.17","type":"verse","n":"17","t":{"la":[{"num":"17"},"Et scietis quia ego Dominus Deus vester,",{"br":1},"habitans in Sion monte sancto meo ;",{"br":1},"et erit Jerusalem sancta,",{"br":1},"et alieni non transibunt per eam amplius.",{"br":1}]}}
{"id":"jol.3.18","type":"verse","n":"18","t":{"la":[{"num":"18"},"Et erit in die illa : stillabunt montes dulcedinem,",{"br":1},"et colles fluent lacte,",{"br":1},"et per omnes rivos Juda ibunt aquæ ;",{"br":1},"et fons de domo Domini egredietur,",{"br":1},"et irrigabit torrentem spinarum.",{"br":1}]}}
{"id":"jol.3.19","type":"verse","n":"19","t":{"la":[{"num":"19"},"Ægyptus in desolationem erit,",{"br":1},"et Idumæa in desertum perditionis,",{"br":1},"pro eo quod inique egerint in filios Juda,",{"br":1},"et effuderint sanguinem innocentem in terra sua.",{"br":1}]}}
{"id":"jol.3.20","type":"verse","n":"20","t":{"la":[{"num":"20"},"Et Judæa in æternum habitabitur,",{"br":1},"et Jerusalem in generationem et generationem.",{"br":1}]}}
{"id":"jol.3.21","type":"verse","n":"21","t":{"la":[{"num":"21"},"Et mundabo sanguinem eorum, quem non mundaveram ;",{"br":1},"et Dominus commorabitur in Sion."]}}
