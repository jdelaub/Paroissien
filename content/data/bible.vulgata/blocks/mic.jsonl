{"id":"mic.titre","type":"heading","level":1,"t":{"la":["Prophetia Michææ"]}}
{"id":"mic.1","type":"heading","level":2,"label":"Caput 1","t":{"la":["Caput 1"]}}
{"id":"mic.1.1","type":"verse","n":"1","p":true,"dropCap":true,"t":{"la":[{"num":"1"},"Verbum Domini, quod factum est ad Michæam Morasthiten, in diebus Joathan, Achaz, et Ezechiæ, regum Juda, quod vidit super Samariam et Jerusalem."]}}
{"id":"mic.1.2","type":"verse","n":"2","p":true,"t":{"la":[{"num":"2"},"Audite, populi omnes,",{"br":1},"et attendat terra, et plenitudo ejus :",{"br":1},"et sit Dominus Deus vobis in testem,",{"br":1},"Dominus de templo sancto suo.",{"br":1}]}}
{"id":"mic.1.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Quia ecce Dominus egredietur de loco suo,",{"br":1},"et descendet, et calcabit super excelsa terræ.",{"br":1}]}}
{"id":"mic.1.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Et consumentur montes subtus eum,",{"br":1},"et valles scindentur sicut cera a facie ignis,",{"br":1},"et sicut aquæ quæ decurrunt in præceps.",{"br":1}]}}
{"id":"mic.1.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"In scelere Jacob omne istud,",{"br":1},"et in peccatis domus Israël.",{"br":1},"Quod scelus Jacob ? nonne Samaria ?",{"br":1},"et quæ excelsa Judæ ? nonne Jerusalem ?",{"br":1}]}}
{"id":"mic.1.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Et ponam Samariam quasi acervum lapidum in agro,",{"br":1},"cum plantatur vinea ;",{"br":1},"et detraham in vallem lapides ejus,",{"br":1},"et fundamenta ejus revelabo.",{"br":1}]}}
{"id":"mic.1.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Et omnia sculptilia ejus concidentur,",{"br":1},"et omnes mercedes ejus comburentur igne,",{"br":1},"et omnia idola ejus ponam in perditionem,",{"br":1},"quia de mercedibus meretricis congregata sunt,",{"br":1},"et usque ad mercedem meretricis revertentur.",{"br":1}]}}
{"id":"mic.1.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Super hoc plangam, et ululabo ;",{"br":1},"vadam spoliatus, et nudus ;",{"br":1},"faciam planctum velut draconum,",{"br":1},"et luctum quasi struthionum :",{"br":1}]}}
{"id":"mic.1.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"quia desperata est plaga ejus,",{"br":1},"quia venit usque ad Judam ;",{"br":1},"tetigit portam populi mei usque ad Jerusalem.",{"br":1}]}}
{"id":"mic.1.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"In Geth nolite annuntiare ;",{"br":1},"lacrimis ne ploretis ;",{"br":1},"in domo pulveris pulvere vos conspergite.",{"br":1}]}}
{"id":"mic.1.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Et transite vobis, habitatio pulchra, confusa ignominia :",{"br":1},"non est egressa quæ habitat in exitu :",{"br":1},"planctum domus vicina accipiet ex vobis, quæ stetit sibimet.",{"br":1}]}}
{"id":"mic.1.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"Quia infirmata est in bonum,",{"br":1},"quæ habitat in amaritudinibus ;",{"br":1},"quia descendit malum a Domino in portam Jerusalem.",{"br":1}]}}
{"id":"mic.1.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Tumultus quadrigæ stuporis habitanti Lachis :",{"br":1},"principium peccati est filiæ Sion,",{"br":1},"quia in te inventa sunt scelera Israël.",{"br":1}]}}
{"id":"mic.1.14","type":"verse","n":"14","t":{"la":[{"num":"14"},"Propterea dabit emissarios super hæreditatem Geth,",{"br":1},"domus mendacii in deceptionem regibus Israël.",{"br":1}]}}
{"id":"mic.1.15","type":"verse","n":"15","t":{"la":[{"num":"15"},"Adhuc hæredem adducam tibi quæ habitas in Maresa ;",{"br":1},"usque ad Odollam veniet gloria Israël.",{"br":1}]}}
{"id":"mic.1.16","type":"verse","n":"16","t":{"la":[{"num":"16"},"Decalvare, et tondere super filios deliciarum tuarum ;",{"br":1},"dilata calvitium tuum sicut aquila,",{"br":1},"quoniam captivi ducti sunt ex te."]}}
{"id":"mic.2","type":"heading","level":2,"label":"Caput 2","t":{"la":["Caput 2"]}}
{"id":"mic.2.1","type":"verse","n":"1","p":true,"t":{"la":[{"num":"1"},"Væ qui cogitatis inutile,",{"br":1},"et operamini malum in cubilibus vestris !",{"br":1},"In luce matutina faciunt illud,",{"br":1},"quoniam contra Deum est manus eorum.",{"br":1}]}}
{"id":"mic.2.2","type":"verse","n":"2","t":{"la":[{"num":"2"},"Et concupierunt agros, et violenter tulerunt :",{"br":1},"et rapuerunt domos,",{"br":1},"et calumniabantur virum, et domum ejus :",{"br":1},"virum, et hæreditatem ejus.",{"br":1}]}}
{"id":"mic.2.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Idcirco hæc dicit Dominus :",{"br":1},"Ecce ego cogito super familiam istam malum,",{"br":1},"unde non auferetis colla vestra,",{"br":1},"et non ambulabitis superbi :",{"br":1},"quoniam tempus pessimum est.",{"br":1}]}}
{"id":"mic.2.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"In die illa sumetur super vos parabola,",{"br":1},"et cantabitur canticum cum suavitate, dicentium :",{"br":1},"Depopulatione vastati sumus ;",{"br":1},"pars populi mei commutata est :",{"br":1},"quomodo recedet a me, cum revertatur,",{"br":1},"qui regiones nostras dividat ?",{"br":1}]}}
{"id":"mic.2.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Propter hoc non erit tibi mittens funiculum sortis in cœtu Domini.",{"br":1}]}}
{"id":"mic.2.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Ne loquamini loquentes ;",{"br":1},"non stillabit super istos, non comprehendet confusio.",{"br":1}]}}
{"id":"mic.2.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Dicit domus Jacob :",{"br":1},"Numquid abbreviatus est spiritus Domini,",{"br":1},"aut tales sunt cogitationes ejus ?",{"br":1},"nonne verba mea bona sunt cum eo qui recte graditur ?",{"br":1}]}}
{"id":"mic.2.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"et e contrario populus meus in adversarium consurrexit.",{"br":1},"Desuper tunica pallium sustulistis :",{"br":1},"et eos qui transibant simpliciter convertistis in bellum.",{"br":1}]}}
{"id":"mic.2.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Mulieres populi mei ejecistis de domo deliciarum suarum ;",{"br":1},"a parvulis earum tulistis laudem meam in perpetuum.",{"br":1}]}}
{"id":"mic.2.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Surgite, et ite, quia non habetis hic requiem :",{"br":1},"propter immunditiam ejus corrumpetur putredine pessima.",{"br":1}]}}
{"id":"mic.2.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Utinam non essem vir habens spiritum,",{"br":1},"et mendacium potius loquerer !",{"br":1},"Stillabo tibi in vinum et in ebrietatem ;",{"br":1},"et erit super quem stillatur populus iste.",{"br":1}]}}
{"id":"mic.2.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"Congregatione congregabo, Jacob, totum te ;",{"br":1},"in unum conducam reliquias Israël :",{"br":1},"pariter ponam illum quasi gregem in ovili,",{"br":1},"quasi pecus in medio caularum :",{"br":1},"tumultuabuntur a multitudine hominum.",{"br":1}]}}
{"id":"mic.2.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Ascendet enim pandens iter ante eos :",{"br":1},"divident, et transibunt portam,",{"br":1},"et ingredientur per eam :",{"br":1},"et transibit rex eorum coram eis,",{"br":1},"et Dominus in capite eorum."]}}
{"id":"mic.3","type":"heading","level":2,"label":"Caput 3","t":{"la":["Caput 3"]}}
{"id":"mic.3.1","type":"verse","n":"1","p":true,"t":{"la":[{"num":"1"},"Et dixi : Audite, principes Jacob,",{"br":1},"et duces domus Israël :",{"br":1},"numquid non vestrum est scire judicium,",{"br":1}]}}
{"id":"mic.3.2","type":"verse","n":"2","t":{"la":[{"num":"2"},"qui odio habetis bonum, et diligitis malum ;",{"br":1},"qui violenter tollitis pelles eorum desuper eis,",{"br":1},"et carnem eorum desuper ossibus eorum ;",{"br":1}]}}
{"id":"mic.3.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"qui comederunt carnem populi mei,",{"br":1},"et pellem eorum desuper excoriaverunt,",{"br":1},"et ossa eorum confregerunt,",{"br":1},"et conciderunt sicut in lebete,",{"br":1},"et quasi carnem in medio ollæ ?",{"br":1}]}}
{"id":"mic.3.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Tunc clamabunt ad Dominum, et non exaudiet eos,",{"br":1},"et abscondet faciem suam ab eis in tempore illo,",{"br":1},"sicut nequiter egerunt in adinventionibus suis.",{"br":1}]}}
{"id":"mic.3.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Hæc dicit Dominus super prophetas,",{"br":1},"qui seducunt populum meum :",{"br":1},"qui mordent dentibus suis,",{"br":1},"et prædicant pacem ;",{"br":1},"et si quis non dederit in ore eorum quippiam,",{"br":1},"sanctificant super eum prælium.",{"br":1}]}}
{"id":"mic.3.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Propterea nox vobis pro visione erit,",{"br":1},"et tenebræ vobis pro divinatione ;",{"br":1},"et occumbet sol super prophetas,",{"br":1},"et obtenebrabitur super eos dies.",{"br":1}]}}
{"id":"mic.3.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Et confundentur qui vident visiones,",{"br":1},"et confundentur divini ;",{"br":1},"et operient omnes vultos suos,",{"br":1},"quia non est responsum Dei.",{"br":1}]}}
{"id":"mic.3.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Verumtamen ego repletus sum fortitudine spiritus Domini,",{"br":1},"judicio, et virtute,",{"br":1},"ut annuntiem Jacob scelus suum,",{"br":1},"et Israël peccatum suum.",{"br":1}]}}
{"id":"mic.3.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Audite hoc, principes domus Jacob,",{"br":1},"et judices domus Israël,",{"br":1},"qui abominamini judicium,",{"br":1},"et omnia recta pervertitis :",{"br":1}]}}
{"id":"mic.3.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"qui ædificatis Sion in sanguinibus,",{"br":1},"et Jerusalem in iniquitate.",{"br":1}]}}
{"id":"mic.3.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Principes ejus in muneribus judicabant,",{"br":1},"et sacerdotes ejus in mercede docebant,",{"br":1},"et prophetæ ejus in pecunia divinabant :",{"br":1},"et super Dominum requiescebant, dicentes :",{"br":1},"Numquid non Dominus in medio nostrum ?",{"br":1},"non venient super nos mala.",{"br":1}]}}
{"id":"mic.3.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"Propter hoc, causa vestri, Sion quasi ager arabitur,",{"br":1},"et Jerusalem quasi acervus lapidum erit,",{"br":1},"et mons templi in excelsa silvarum."]}}
{"id":"mic.4","type":"heading","level":2,"label":"Caput 4","t":{"la":["Caput 4"]}}
{"id":"mic.4.1","type":"verse","n":"1","p":true,"t":{"la":[{"num":"1"},"Et erit : in novissimo dierum",{"br":1},"erit mons domus Domini præparatus in vertice montium,",{"br":1},"et sublimis super colles :",{"br":1},"et fluent ad eum populi,",{"br":1}]}}
{"id":"mic.4.2","type":"verse","n":"2","t":{"la":[{"num":"2"},"et properabunt gentes multæ, et dicent :",{"br":1},"Venite, ascendamus ad montem Domini,",{"br":1},"et ad domum Dei Jacob :",{"br":1},"et docebit nos de viis suis,",{"br":1},"et ibimus in semitis ejus,",{"br":1},"quia de Sion egredietur lex,",{"br":1},"et verbum Domini de Jerusalem.",{"br":1}]}}
{"id":"mic.4.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Et judicabit inter populos multos,",{"br":1},"et corripiet gentes fortes usque in longinquum :",{"br":1},"et concident gladios suos in vomeres,",{"br":1},"et hastas suas in ligones :",{"br":1},"non sumet gens adversus gentem gladium,",{"br":1},"et non discent ultra belligerare.",{"br":1}]}}
{"id":"mic.4.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Et sedebit vir subtus vitem suam et subtus ficum suam,",{"br":1},"et non erit qui deterreat,",{"br":1},"quia os Domini exercituum locutum est.",{"br":1}]}}
{"id":"mic.4.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Quia omnes populi ambulabunt",{"br":1},"unusquisque in nomine dei sui ;",{"br":1},"nos autem ambulabimus",{"br":1},"in nomine Domini Dei nostri,",{"br":1},"in æternum et ultra."]}}
{"id":"mic.4.6","type":"verse","n":"6","p":true,"t":{"la":[{"num":"6"},"In die illa, dicit Dominus,",{"br":1},"congregabo claudicantem,",{"br":1},"et eam quam ejeceram colligam,",{"br":1},"et quam afflixeram :",{"br":1}]}}
{"id":"mic.4.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"et ponam claudicantem in reliquias,",{"br":1},"et eam quæ laboraverat, in gentem robustam :",{"br":1},"et regnabit Dominus super eos in monte Sion,",{"br":1},"ex hoc nunc et usque in æternum.",{"br":1}]}}
{"id":"mic.4.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Et tu, turris gregis nebulosa filiæ Sion,",{"br":1},"usque ad te veniet,",{"br":1},"et veniet potestas prima,",{"br":1},"regnum filiæ Jerusalem.",{"br":1}]}}
{"id":"mic.4.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Nunc quare mœrore contraheris ?",{"br":1},"numquid rex non est tibi,",{"br":1},"aut consiliarius tuus periit,",{"br":1},"quia comprehendit te dolor sicut parturientem ?",{"br":1}]}}
{"id":"mic.4.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Dole et satage, filia Sion, quasi parturiens,",{"br":1},"quia nunc egredieris de civitate,",{"br":1},"et habitabis in regione,",{"br":1},"et venies usque ad Babylonem :",{"br":1},"ibi liberaberis,",{"br":1},"ibi redimet te Dominus de manu inimicorum tuorum.",{"br":1}]}}
{"id":"mic.4.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Et nunc congregatæ sunt super te gentes multæ, quæ dicunt :",{"br":1},"Lapidetur, et aspiciat in Sion oculus noster.",{"br":1}]}}
{"id":"mic.4.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"Ipsi autem non cognoverunt cogitationes Domini,",{"br":1},"et non intellexerunt consilium ejus,",{"br":1},"quia congregavit eos quasi fœnum areæ.",{"br":1}]}}
{"id":"mic.4.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Surge, et tritura, filia Sion,",{"br":1},"quia cornu tuum ponam ferreum,",{"br":1},"et ungulas tuas ponam æreas ;",{"br":1},"et comminues populos multos,",{"br":1},"et interficies Domino rapinas eorum,",{"br":1},"et fortitudinem eorum Domino universæ terræ."]}}
{"id":"mic.5","type":"heading","level":2,"label":"Caput 5","t":{"la":["Caput 5"]}}
{"id":"mic.5.1","type":"verse","n":"1","p":true,"t":{"la":[{"num":"1"},"Nunc vastaberis, filia latronis.",{"br":1},"Obsidionem posuerunt super nos :",{"br":1},"in virga percutient maxillam judicis Israël."]}}
{"id":"mic.5.2","type":"verse","n":"2","p":true,"t":{"la":[{"num":"2"},"Et tu, Bethlehem Ephrata,",{"br":1},"parvulus es in millibus Juda ;",{"br":1},"ex te mihi egredietur qui sit dominator in Israël,",{"br":1},"et egressus ejus ab initio,",{"br":1},"a diebus æternitatis.",{"br":1}]}}
{"id":"mic.5.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Propter hoc dabit eos usque ad tempus in quo parturiens pariet,",{"br":1},"et reliquiæ fratrum ejus convertentur ad filios Israël.",{"br":1}]}}
{"id":"mic.5.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Et stabit, et pascet in fortitudine Domini,",{"br":1},"in sublimitate nominis Domini Dei sui :",{"br":1},"et convertentur,",{"br":1},"quia nunc magnificabitur usque ad terminos terræ.",{"br":1}]}}
{"id":"mic.5.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Et erit iste pax :",{"br":1},"cum venerit Assyrius in terram nostram,",{"br":1},"et quando calcaverit in domibus nostris,",{"br":1},"et suscitabimus super eum septem pastores",{"br":1},"et octo primates homines ;",{"br":1}]}}
{"id":"mic.5.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"et pascent terram Assur in gladio,",{"br":1},"et terram Nemrod in lanceis ejus,",{"br":1},"et liberabit ab Assur cum venerit in terram nostram,",{"br":1},"et cum calcaverit in finibus nostris.",{"br":1}]}}
{"id":"mic.5.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Et erunt reliquiæ Jacob in medio populorum multorum",{"br":1},"quasi ros a Domino,",{"br":1},"et quasi stillæ super herbam,",{"br":1},"quæ non exspectat virum,",{"br":1},"et non præstolatur filios hominum.",{"br":1}]}}
{"id":"mic.5.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Et erunt reliquiæ Jacob in gentibus,",{"br":1},"in medio populorum multorum,",{"br":1},"quasi leo in jumentis silvarum,",{"br":1},"et quasi catulus leonis in gregibus pecorum,",{"br":1},"qui cum transierit, et conculcaverit, et ceperit,",{"br":1},"non est qui eruat.",{"br":1}]}}
{"id":"mic.5.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Exaltabitur manus tua super hostes tuos,",{"br":1},"et omnes inimici tui interibunt.",{"br":1}]}}
{"id":"mic.5.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Et erit in die illa, dicit Dominus :",{"br":1},"auferam equos tuos de medio tui,",{"br":1},"et disperdam quadrigas tuas.",{"br":1}]}}
{"id":"mic.5.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Et perdam civitates terræ tuæ,",{"br":1},"et destruam omnes munitiones tuas :",{"br":1},"et auferam maleficia de manu tua,",{"br":1},"et divinationes non erunt in te :",{"br":1}]}}
{"id":"mic.5.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"et perire faciam sculptilia tua et statuas tuas de medio tui,",{"br":1},"et non adorabis ultra opera manuum tuarum :",{"br":1}]}}
{"id":"mic.5.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"et evellam lucos tuos de medio tui,",{"br":1},"et conteram civitates tuas.",{"br":1}]}}
{"id":"mic.5.14","type":"verse","n":"14","t":{"la":[{"num":"14"},"Et faciam, in furore et in indignatione, ultionem",{"br":1},"in omnibus gentibus quæ non audierunt."]}}
{"id":"mic.6","type":"heading","level":2,"label":"Caput 6","t":{"la":["Caput 6"]}}
{"id":"mic.6.1","type":"verse","n":"1","p":true,"t":{"la":[{"num":"1"},"Audite quæ Dominus loquitur :",{"br":1},"Surge, contende judicio adversum montes,",{"br":1},"et audiant colles vocem tuam.",{"br":1}]}}
{"id":"mic.6.2","type":"verse","n":"2","t":{"la":[{"num":"2"},"Audiant montes judicium Domini,",{"br":1},"et fortia fundamenta terræ ;",{"br":1},"quia judicium Domini cum populo suo,",{"br":1},"et cum Israël dijudicabitur.",{"br":1}]}}
{"id":"mic.6.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Popule meus, quid feci tibi ?",{"br":1},"aut quid molestus fui tibi ? Responde mihi.",{"br":1}]}}
{"id":"mic.6.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Quia eduxi te de terra Ægypti,",{"br":1},"et de domo servientium liberavi te,",{"br":1},"et misi ante faciem tuam Moysen, et Aaron, et Mariam.",{"br":1}]}}
{"id":"mic.6.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Popule meus, memento, quæso,",{"br":1},"quid cogitaverit Balach, rex Moab,",{"br":1},"et quid responderit ei Balaam, filius Beor,",{"br":1},"de Setim usque ad Galgalam,",{"br":1},"ut cognosceres justitias Domini.",{"br":1}]}}
{"id":"mic.6.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Quid dignum offeram Domino ?",{"br":1},"curvabo genu Deo excelso ?",{"br":1},"Numquid offeram ei holocautomata et vitulos anniculos ?",{"br":1}]}}
{"id":"mic.6.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"numquid placari potest Dominus in millibus arietum,",{"br":1},"aut in multis millibus hircorum pinguium ?",{"br":1},"numquid dabo primogenitum meum pro scelere meo,",{"br":1},"fructum ventris mei pro peccato animæ meæ ?",{"br":1}]}}
{"id":"mic.6.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Indicabo tibi, o homo, quid sit bonum,",{"br":1},"et quid Dominus requirat a te :",{"br":1},"utique facere judicium,",{"br":1},"et diligere misericordiam,",{"br":1},"et sollicitum ambulare cum Deo tuo.",{"br":1}]}}
{"id":"mic.6.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Vox Domini ad civitatem clamat,",{"br":1},"et salus erit timentibus nomen tuum :",{"br":1},"audite, tribus, et quis approbabit illud ?",{"br":1}]}}
{"id":"mic.6.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Adhuc ignis in domo impii thesauri iniquitatis,",{"br":1},"et mensura minor iræ plena.",{"br":1}]}}
{"id":"mic.6.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Numquid justificabo stateram impiam,",{"br":1},"et saccelli pondera dolosa ?",{"br":1}]}}
{"id":"mic.6.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"In quibus divites ejus repleti sunt iniquitate,",{"br":1},"et habitantes in ea loquebantur mendacium,",{"br":1},"et lingua eorum fraudulenta in ore eorum.",{"br":1}]}}
{"id":"mic.6.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Et ego ergo cœpi percutere te perditione super peccatis tuis.",{"br":1}]}}
{"id":"mic.6.14","type":"verse","n":"14","t":{"la":[{"num":"14"},"Tu comedes, et non saturaberis,",{"br":1},"et humiliatio tua in medio tui :",{"br":1},"et apprehendes, et non salvabis,",{"br":1},"et quos salvaveris, in gladium dabo.",{"br":1}]}}
{"id":"mic.6.15","type":"verse","n":"15","t":{"la":[{"num":"15"},"Tu seminabis, et non metes :",{"br":1},"tu calcabis olivam, et non ungeris oleo ;",{"br":1},"et mustum, et non bibes vinum.",{"br":1}]}}
{"id":"mic.6.16","type":"verse","n":"16","t":{"la":[{"num":"16"},"Et custodisti præcepta Amri,",{"br":1},"et omne opus domus Achab,",{"br":1},"et ambulasti in voluntatibus eorum :",{"br":1},"ut darem te in perditionem,",{"br":1},"et habitantes in ea in sibilum,",{"br":1},"et opprobrium populi mei portabitis."]}}
{"id":"mic.7","type":"heading","level":2,"label":"Caput 7","t":{"la":["Caput 7"]}}
{"id":"mic.7.1","type":"verse","n":"1","p":true,"t":{"la":[{"num":"1"},"Væ mihi, quia factus sum sicut qui colligit in autumno racemos vindemiæ !",{"br":1},"non est botrus ad comedendum,",{"br":1},"præcoquas ficus desideravit anima mea.",{"br":1}]}}
{"id":"mic.7.2","type":"verse","n":"2","t":{"la":[{"num":"2"},"Periit sanctus de terra,",{"br":1},"et rectus in hominibus non est :",{"br":1},"omnes in sanguine insidiantur ;",{"br":1},"vir fratrem suum ad mortem venatur.",{"br":1}]}}
{"id":"mic.7.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Malum manuum suarum dicunt bonum :",{"br":1},"princeps postulat, et judex in reddendo est ;",{"br":1},"et magnus locutus est desiderium animæ suæ,",{"br":1},"et conturbaverunt eam.",{"br":1}]}}
{"id":"mic.7.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Qui optimus in eis est, quasi paliurus,",{"br":1},"et qui rectus, quasi spina de sepe.",{"br":1},"Dies speculationis tuæ, visitatio tua venit :",{"br":1},"nunc erit vastitas eorum.",{"br":1}]}}
{"id":"mic.7.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Nolite credere amico,",{"br":1},"et nolite confidere in duce :",{"br":1},"ab ea quæ dormit in sinu tuo custodi claustra oris tui.",{"br":1}]}}
{"id":"mic.7.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Quia filius contumeliam facit patri,",{"br":1},"et filia consurgit adversus matrem suam :",{"br":1},"nurus adversus socrum suam,",{"br":1},"et inimici hominis domestici ejus."]}}
{"id":"mic.7.7","type":"verse","n":"7","p":true,"t":{"la":[{"num":"7"},"Ego autem ad Dominum aspiciam ;",{"br":1},"exspectabo Deum, salvatorem meum :",{"br":1},"audiet me Deus meus.",{"br":1}]}}
{"id":"mic.7.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Ne læteris, inimica mea, super me, quia cecidi :",{"br":1},"consurgam cum sedero in tenebris :",{"br":1},"Dominus lux mea est.",{"br":1}]}}
{"id":"mic.7.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Iram Domini portabo,",{"br":1},"quoniam peccavi ei,",{"br":1},"donec causam meam judicet,",{"br":1},"et faciat judicium meum.",{"br":1},"Educet me in lucem :",{"br":1},"videbo justitiam ejus.",{"br":1}]}}
{"id":"mic.7.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Et aspiciet inimica mea,",{"br":1},"et operietur confusione,",{"br":1},"quæ dicit ad me : Ubi est Dominus Deus tuus ?",{"br":1},"Oculi mei videbunt in eam :",{"br":1},"nunc erit in conculcationem ut lutum platearum.",{"br":1}]}}
{"id":"mic.7.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Dies, ut ædificentur maceriæ tuæ ;",{"br":1},"in die illa longe fiet lex.",{"br":1}]}}
{"id":"mic.7.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"In die illa et usque ad te veniet de Assur,",{"br":1},"et usque ad civitates munitas,",{"br":1},"et a civitatibus munitis usque ad flumen,",{"br":1},"et ad mare de mari,",{"br":1},"et ad montem de monte.",{"br":1}]}}
{"id":"mic.7.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Et terra erit in desolationem propter habitatores suos,",{"br":1},"et propter fructum cogitationum eorum."]}}
{"id":"mic.7.14","type":"verse","n":"14","p":true,"t":{"la":[{"num":"14"},"Pasce populum tuum in virga tua,",{"br":1},"gregem hæreditatis tuæ, habitantes solos, in saltu, in medio Carmeli.",{"br":1},"Pascentur Basan et Galaad juxta dies antiquos.",{"br":1}]}}
{"id":"mic.7.15","type":"verse","n":"15","t":{"la":[{"num":"15"},"Secundum dies egressionis tuæ de terra Ægypti,",{"br":1},"ostendam ei mirabilia.",{"br":1}]}}
{"id":"mic.7.16","type":"verse","n":"16","t":{"la":[{"num":"16"},"Videbunt gentes,",{"br":1},"et confundentur super omni fortitudine sua.",{"br":1},"Ponent manum super os,",{"br":1},"aures eorum surdæ erunt.",{"br":1}]}}
{"id":"mic.7.17","type":"verse","n":"17","t":{"la":[{"num":"17"},"Lingent pulverem sicut serpentes ;",{"br":1},"velut reptilia terræ perturbabuntur in ædibus suis.",{"br":1},"Dominum Deum nostrum formidabunt,",{"br":1},"et timebunt te.",{"br":1}]}}
{"id":"mic.7.18","type":"verse","n":"18","t":{"la":[{"num":"18"},"Quis, Deus, similis tui,",{"br":1},"qui aufers iniquitatem,",{"br":1},"et transis peccatum reliquiarum hæreditatis tuæ ?",{"br":1},"Non immittet ultra furorem suum,",{"br":1},"quoniam volens misericordiam est.",{"br":1}]}}
{"id":"mic.7.19","type":"verse","n":"19","t":{"la":[{"num":"19"},"Revertetur, et miserebitur nostri ;",{"br":1},"deponet iniquitates nostras,",{"br":1},"et projiciet in profundum maris omnia peccata nostra.",{"br":1}]}}
{"id":"mic.7.20","type":"verse","n":"20","t":{"la":[{"num":"20"},"Dabis veritatem Jacob,",{"br":1},"misericordiam Abraham,",{"br":1},"quæ jurasti patribus nostris a diebus antiquis."]}}
