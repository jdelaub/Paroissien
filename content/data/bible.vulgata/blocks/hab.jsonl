{"id":"hab.titre","type":"heading","level":1,"t":{"la":["Prophetia Habacuc"]}}
{"id":"hab.1","type":"heading","level":2,"label":"Caput 1","t":{"la":["Caput 1"]}}
{"id":"hab.1.1","type":"verse","n":"1","p":true,"dropCap":true,"t":{"la":[{"num":"1"},"Onus quod vidit Habacuc propheta."]}}
{"id":"hab.1.2","type":"verse","n":"2","p":true,"t":{"la":[{"num":"2"},"Usquequo, Domine, clamabo,",{"br":1},"et non exaudies ?",{"br":1},"vociferabor ad te, vim patiens,",{"br":1},"et non salvabis ?",{"br":1}]}}
{"id":"hab.1.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Quare ostendisti mihi iniquitatem et laborem,",{"br":1},"videre prædam et injustitiam contra me ?",{"br":1},"Et factum est judicium, et contradictio potentior.",{"br":1}]}}
{"id":"hab.1.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Propter hoc lacerata est lex,",{"br":1},"et non pervenit usque ad finem judicium ;",{"br":1},"quia impius prævalet adversus justum,",{"br":1},"propterea egreditur judicium perversum.",{"br":1}]}}
{"id":"hab.1.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Aspicite in gentibus, et videte ;",{"br":1},"admiramini, et obstupescite :",{"br":1},"quia opus factum est in diebus vestris,",{"br":1},"quod nemo credet cum narrabitur.",{"br":1}]}}
{"id":"hab.1.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Quia ecce ego suscitabo Chaldæos,",{"br":1},"gentem amaram et velocem,",{"br":1},"ambulantem super latitudinem terræ,",{"br":1},"ut possideat tabernacula non sua.",{"br":1}]}}
{"id":"hab.1.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Horribilis et terribilis est :",{"br":1},"ex semetipsa judicium et onus ejus egredietur.",{"br":1}]}}
{"id":"hab.1.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Leviores pardis equi ejus,",{"br":1},"et velociores lupis vespertinis :",{"br":1},"et diffundentur equites ejus :",{"br":1},"equites namque ejus de longe venient ;",{"br":1},"volabunt quasi aquila festinans ad comedendum.",{"br":1}]}}
{"id":"hab.1.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Omnes ad prædam venient,",{"br":1},"facies eorum ventus urens ;",{"br":1},"et congregabit quasi arenam captivitatem.",{"br":1}]}}
{"id":"hab.1.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Et ipse de regibus triumphabit,",{"br":1},"et tyranni ridiculi ejus erunt ;",{"br":1},"ipse super omnem munitionem ridebit,",{"br":1},"et comportabit aggerem, et capiet eam.",{"br":1}]}}
{"id":"hab.1.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Tunc mutabitur spiritus, et pertransibit, et corruet :",{"br":1},"hæc est fortitudo ejus dei sui."]}}
{"id":"hab.1.12","type":"verse","n":"12","p":true,"t":{"la":[{"num":"12"},"Numquid non tu a principio,",{"br":1},"Domine, Deus meus, sancte meus,",{"br":1},"et non moriemur ?",{"br":1},"Domine, in judicium posuisti eum,",{"br":1},"et fortem, ut corriperes, fundasti eum.",{"br":1}]}}
{"id":"hab.1.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Mundi sunt oculi tui, ne videas malum,",{"br":1},"et respicere ad iniquitatem non poteris.",{"br":1},"Quare respicis super iniqua agentes,",{"br":1},"et taces devorante impio justiorem se ?",{"br":1}]}}
{"id":"hab.1.14","type":"verse","n":"14","t":{"la":[{"num":"14"},"Et facies homines quasi pisces maris,",{"br":1},"et quasi reptile non habens principem.",{"br":1}]}}
{"id":"hab.1.15","type":"verse","n":"15","t":{"la":[{"num":"15"},"Totum in hamo sublevavit,",{"br":1},"traxit illud in sagena sua,",{"br":1},"et congregavit in rete suum.",{"br":1},"Super hoc lætabitur, et exsultabit.",{"br":1}]}}
{"id":"hab.1.16","type":"verse","n":"16","t":{"la":[{"num":"16"},"Propterea immolabit sagenæ suæ,",{"br":1},"et sacrificabit reti suo,",{"br":1},"quia in ipsis incrassata est pars ejus,",{"br":1},"et cibus ejus electus.",{"br":1}]}}
{"id":"hab.1.17","type":"verse","n":"17","t":{"la":[{"num":"17"},"Propter hoc ergo expandit sagenam suam,",{"br":1},"et semper interficere gentes non parcet."]}}
{"id":"hab.2","type":"heading","level":2,"label":"Caput 2","t":{"la":["Caput 2"]}}
{"id":"hab.2.1","type":"verse","n":"1","p":true,"t":{"la":[{"num":"1"},"Super custodiam meam stabo,",{"br":1},"et figam gradum super munitionem :",{"br":1},"et contemplabor ut videam quid dicatur mihi,",{"br":1},"et quid respondeam ad arguentem me."]}}
{"id":"hab.2.2","type":"verse","n":"2","p":true,"t":{"la":[{"num":"2"},"Et respondit mihi Dominus, et dixit : Scribe visum, et explana eum super tabulas,",{"br":1},"ut percurrat qui legerit eum.",{"br":1}]}}
{"id":"hab.2.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Quia adhuc visus procul ;",{"br":1},"et apparebit in finem, et non mentietur :",{"br":1},"si moram fecerit, exspecta illum,",{"br":1},"quia veniens veniet, et non tardabit.",{"br":1}]}}
{"id":"hab.2.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Ecce qui incredulus est, non erit recta anima ejus in semetipso ;",{"br":1},"justus autem in fide sua vivet.",{"br":1}]}}
{"id":"hab.2.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Et quomodo vinum potantem decipit,",{"br":1},"sic erit vir superbus, et non decorabitur :",{"br":1},"qui dilatavit quasi infernus animam suam,",{"br":1},"et ipse quasi mors, et non adimpletur :",{"br":1},"et congregabit ad se omnes gentes,",{"br":1},"et coacervabit ad se omnes populos.",{"br":1}]}}
{"id":"hab.2.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Numquid non omnes isti super eum parabolam sument,",{"br":1},"et loquelam ænigmatum ejus, et dicetur :",{"br":1},"Væ ei qui multiplicat non sua ?",{"br":1},"usquequo et aggravat contra se densum lutum ?",{"br":1}]}}
{"id":"hab.2.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Numquid non repente consurgent qui mordeant te,",{"br":1},"et suscitabuntur lacerantes te,",{"br":1},"et eris in rapinam eis ?",{"br":1}]}}
{"id":"hab.2.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Quia tu spoliasti gentes multas,",{"br":1},"spoliabunt te omnes qui reliqui fuerint de populis,",{"br":1},"propter sanguinem hominis,",{"br":1},"et iniquitatem terræ, civitatis, et omnium habitantium in ea.",{"br":1}]}}
{"id":"hab.2.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Væ qui congregat avaritiam malam domui suæ,",{"br":1},"ut sit in excelso nidus ejus,",{"br":1},"et liberari se putat de manu mali !",{"br":1}]}}
{"id":"hab.2.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Cogitasti confusionem domui tuæ ;",{"br":1},"concidisti populos multos,",{"br":1},"et peccavit anima tua.",{"br":1}]}}
{"id":"hab.2.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Quia lapis de pariete clamabit,",{"br":1},"et lignum, quod inter juncturas ædificiorum est, respondebit.",{"br":1}]}}
{"id":"hab.2.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"Væ qui ædificat civitatem in sanguinibus,",{"br":1},"et præparat urbem in iniquitate !",{"br":1}]}}
{"id":"hab.2.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Numquid non hæc sunt a Domino exercituum ?",{"br":1},"laborabunt enim populi in multo igne,",{"br":1},"et gentes in vacuum, et deficient.",{"br":1}]}}
{"id":"hab.2.14","type":"verse","n":"14","t":{"la":[{"num":"14"},"Quia replebitur terra, ut cognoscant gloriam Domini,",{"br":1},"quasi aquæ operientes mare.",{"br":1}]}}
{"id":"hab.2.15","type":"verse","n":"15","t":{"la":[{"num":"15"},"Væ qui potum dat amico suo mittens fel suum,",{"br":1},"et inebrians ut aspiciat nuditatem ejus !",{"br":1}]}}
{"id":"hab.2.16","type":"verse","n":"16","t":{"la":[{"num":"16"},"Repletus es ignominia pro gloria ;",{"br":1},"bibe tu quoque, et consopire.",{"br":1},"Circumdabit te calix dexteræ Domini,",{"br":1},"et vomitus ignominiæ super gloriam tuam.",{"br":1}]}}
{"id":"hab.2.17","type":"verse","n":"17","t":{"la":[{"num":"17"},"Quia iniquitas Libani operiet te,",{"br":1},"et vastitas animalium deterrebit eos",{"br":1},"de sanguinibus hominum,",{"br":1},"et iniquitate terræ, et civitatis, et omnium habitantium in ea.",{"br":1}]}}
{"id":"hab.2.18","type":"verse","n":"18","t":{"la":[{"num":"18"},"Quid prodest sculptile, quia sculpsit illud fictor suus,",{"br":1},"conflatile, et imaginem falsam ?",{"br":1},"quia speravit in figmento fictor ejus, ut faceret simulacra muta.",{"br":1}]}}
{"id":"hab.2.19","type":"verse","n":"19","t":{"la":[{"num":"19"},"Væ qui dicit ligno : Expergiscere ;",{"br":1},"Surge, lapidi tacenti !",{"br":1},"Numquid ipse docere poterit ?",{"br":1},"ecce iste coopertus est auro et argento,",{"br":1},"et omnis spiritus non est in visceribus ejus.",{"br":1}]}}
{"id":"hab.2.20","type":"verse","n":"20","t":{"la":[{"num":"20"},"Dominus autem in templo sancto suo :",{"br":1},"sileat a facie ejus omnis terra !"]}}
{"id":"hab.3","type":"heading","level":2,"label":"Caput 3","t":{"la":["Caput 3"]}}
{"id":"hab.3.1","type":"verse","n":"1","p":true,"t":{"la":[{"num":"1"},"Oratio Habacuc prophetæ, pro ignorantiis."]}}
{"id":"hab.3.2","type":"verse","n":"2","p":true,"t":{"la":[{"num":"2"},"Domine, audivi auditionem tuam, et timui.",{"br":1},"Domine, opus tuum, in medio annorum vivifica illud ;",{"br":1},"in medio annorum notum facies :",{"br":1},"cum iratus fueris, misericordiæ recordaberis.",{"br":1}]}}
{"id":"hab.3.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Deus ab austro veniet,",{"br":1},"et Sanctus de monte Pharan :",{"br":1},"operuit cælos gloria ejus,",{"br":1},"et laudis ejus plena est terra.",{"br":1}]}}
{"id":"hab.3.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Splendor ejus ut lux erit,",{"br":1},"cornua in manibus ejus :",{"br":1},"ibi abscondita est fortitudo ejus.",{"br":1}]}}
{"id":"hab.3.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Ante faciem ejus ibit mors,",{"br":1},"et egredietur diabolus ante pedes ejus.",{"br":1}]}}
{"id":"hab.3.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Stetit, et mensus est terram ;",{"br":1},"aspexit, et dissolvit gentes,",{"br":1},"et contriti sunt montes sæculi :",{"br":1},"incurvati sunt colles mundi ab itineribus æternitatis ejus.",{"br":1}]}}
{"id":"hab.3.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Pro iniquitate vidi tentoria Æthiopiæ ;",{"br":1},"turbabuntur pelles terræ Madian.",{"br":1}]}}
{"id":"hab.3.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Numquid in fluminibus iratus es, Domine ?",{"br":1},"aut in fluminibus furor tuus ?",{"br":1},"vel in mari indignatio tua ?",{"br":1},"Qui ascendes super equos tuos, et quadrigæ tuæ salvatio.",{"br":1}]}}
{"id":"hab.3.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Suscitans suscitabis arcum tuum,",{"br":1},"juramenta tribubus quæ locutus es ;",{"br":1},"fluvios scindes terræ.",{"br":1}]}}
{"id":"hab.3.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Viderunt te, et doluerunt montes ;",{"br":1},"gurges aquarum transiit :",{"br":1},"dedit abyssus vocem suam ;",{"br":1},"altitudo manus suas levavit.",{"br":1}]}}
{"id":"hab.3.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Sol et luna steterunt in habitaculo suo :",{"br":1},"in luce sagittarum tuarum ibunt,",{"br":1},"in splendore fulgurantis hastæ tuæ.",{"br":1}]}}
{"id":"hab.3.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"In fremitu conculcabis terram ;",{"br":1},"in furore obstupefacies gentes.",{"br":1}]}}
{"id":"hab.3.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Egressus es in salutem populi tui,",{"br":1},"in salutem cum christo tuo :",{"br":1},"percussisti caput de domo impii,",{"br":1},"denudasti fundamentum ejus usque ad collum.",{"br":1}]}}
{"id":"hab.3.14","type":"verse","n":"14","t":{"la":[{"num":"14"},"Maledixisti sceptris ejus,",{"br":1},"capiti bellatorum ejus,",{"br":1},"venientibus ut turbo ad dispergendum me :",{"br":1},"exsultatio eorum, sicut ejus qui devorat pauperem in abscondito.",{"br":1}]}}
{"id":"hab.3.15","type":"verse","n":"15","t":{"la":[{"num":"15"},"Viam fecisti in mari equis tuis,",{"br":1},"in luto aquarum multarum.",{"br":1}]}}
{"id":"hab.3.16","type":"verse","n":"16","t":{"la":[{"num":"16"},"Audivi, et conturbatus est venter meus ;",{"br":1},"a voce contremuerunt labia mea.",{"br":1},"Ingrediatur putredo in ossibus meis,",{"br":1},"et subter me scateat :",{"br":1},"ut requiescam in die tribulationis,",{"br":1},"ut ascendam ad populum accinctum nostrum.",{"br":1}]}}
{"id":"hab.3.17","type":"verse","n":"17","t":{"la":[{"num":"17"},"Ficus enim non florebit,",{"br":1},"et non erit germen in vineis ;",{"br":1},"mentietur opus olivæ,",{"br":1},"et arva non afferent cibum :",{"br":1},"abscindetur de ovili pecus,",{"br":1},"et non erit armentum in præsepibus.",{"br":1}]}}
{"id":"hab.3.18","type":"verse","n":"18","t":{"la":[{"num":"18"},"Ego autem in Domino gaudebo ;",{"br":1},"et exsultabo in Deo Jesu meo.",{"br":1}]}}
{"id":"hab.3.19","type":"verse","n":"19","t":{"la":[{"num":"19"},"Deus Dominus fortitudo mea,",{"br":1},"et ponet pedes meos quasi cervorum :",{"br":1},"et super excelsa mea deducet me",{"br":1},"victor in psalmis canentem."]}}
