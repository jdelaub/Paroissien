{"id":"nam.titre","type":"heading","level":1,"t":{"la":["Prophetia Nahum"]}}
{"id":"nam.1","type":"heading","level":2,"label":"Caput 1","t":{"la":["Caput 1"]}}
{"id":"nam.1.1","type":"verse","n":"1","p":true,"dropCap":true,"t":{"la":[{"num":"1"},"Onus Ninive. Liber visionis Nahum Elcesæi."]}}
{"id":"nam.1.2","type":"verse","n":"2","p":true,"t":{"la":[{"num":"2"},"Deus æmulator, et ulciscens Dominus :",{"br":1},"ulciscens Dominus, et habens furorem :",{"br":1},"ulciscens Dominus in hostes suos,",{"br":1},"et irascens ipse inimicis suis.",{"br":1}]}}
{"id":"nam.1.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Dominus patiens, et magnus fortitudine,",{"br":1},"et mundans non faciet innocentem.",{"br":1},"Dominus in tempestate et turbine viæ ejus,",{"br":1},"et nebulæ pulvis pedum ejus.",{"br":1}]}}
{"id":"nam.1.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Increpans mare, et exsiccans illud,",{"br":1},"et omnia flumina ad desertum deducens.",{"br":1},"Infirmatus est Basan et Carmelus,",{"br":1},"et flos Libani elanguit.",{"br":1}]}}
{"id":"nam.1.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Montes commoti sunt ab eo,",{"br":1},"et colles desolati sunt :",{"br":1},"et contremuit terra a facie ejus,",{"br":1},"et orbis, et omnes habitantes in eo.",{"br":1}]}}
{"id":"nam.1.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Ante faciem indignationis ejus quis stabit ?",{"br":1},"et quis resistet in ira furoris ejus ?",{"br":1},"Indignatio ejus effusa est ut ignis,",{"br":1},"et petræ dissolutæ sunt ab eo.",{"br":1}]}}
{"id":"nam.1.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Bonus Dominus,",{"br":1},"et confortans in die tribulationis,",{"br":1},"et sciens sperantes in se.",{"br":1}]}}
{"id":"nam.1.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Et in diluvio prætereunte consummationem faciet loci ejus,",{"br":1},"et inimicos ejus persequentur tenebræ.",{"br":1}]}}
{"id":"nam.1.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Quid cogitatis contra Dominum ?",{"br":1},"Consummationem ipse faciet :",{"br":1},"non consurget duplex tribulatio,",{"br":1}]}}
{"id":"nam.1.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"quia sicut spinæ se invicem complectuntur,",{"br":1},"sic convivium eorum pariter potantium ;",{"br":1},"consumentur quasi stipula ariditate plena.",{"br":1}]}}
{"id":"nam.1.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Ex te exibit cogitans contra Dominum malitiam,",{"br":1},"mente pertractans prævaricationem.",{"br":1}]}}
{"id":"nam.1.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"Hæc dicit Dominus :",{"br":1},"Si perfecti fuerint, et ita plures,",{"br":1},"sic quoque attondentur, et pertransibit :",{"br":1},"afflixi te, et non affligam te ultra.",{"br":1}]}}
{"id":"nam.1.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Et nunc conteram virgam ejus de dorso tuo,",{"br":1},"et vincula tua disrumpam.",{"br":1}]}}
{"id":"nam.1.14","type":"verse","n":"14","t":{"la":[{"num":"14"},"Et præcipiet super te Dominus ;",{"br":1},"non seminabitur ex nomine tuo amplius :",{"br":1},"de domo Dei tui interficiam sculptile, et conflatile ;",{"br":1},"ponam sepulchrum tuum, quia inhonoratus es.",{"br":1}]}}
{"id":"nam.1.15","type":"verse","n":"15","t":{"la":[{"num":"15"},"Ecce super montes pedes evangelizantis,",{"br":1},"et annuntiantis pacem.",{"br":1},"Celebra, Juda, festivitates tuas,",{"br":1},"et redde vota tua,",{"br":1},"quia non adjiciet ultra ut pertranseat in te Belial :",{"br":1},"universus interiit."]}}
{"id":"nam.2","type":"heading","level":2,"label":"Caput 2","t":{"la":["Caput 2"]}}
{"id":"nam.2.1","type":"verse","n":"1","p":true,"t":{"la":[{"num":"1"},"Ascendit qui dispergat coram te,",{"br":1},"qui custodiat obsidionem :",{"br":1},"contemplare viam, conforta lumbos,",{"br":1},"robora virtutem valde.",{"br":1}]}}
{"id":"nam.2.2","type":"verse","n":"2","t":{"la":[{"num":"2"},"Quia reddidit Dominus superbiam Jacob,",{"br":1},"sicut superbiam Israël ;",{"br":1},"quia vastatores dissipaverunt eos,",{"br":1},"et propagines eorum corruperunt.",{"br":1}]}}
{"id":"nam.2.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"Clypeus fortium ejus ignitus,",{"br":1},"viri exercitus in coccineis ;",{"br":1},"igneæ habenæ currus in die præparationis ejus,",{"br":1},"et agitatores consopiti sunt.",{"br":1}]}}
{"id":"nam.2.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"In itineribus conturbati sunt ;",{"br":1},"quadrigæ collisæ sunt in plateis :",{"br":1},"aspectus eorum quasi lampades,",{"br":1},"quasi fulgura discurrentia.",{"br":1}]}}
{"id":"nam.2.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Recordabitur fortium suorum ;",{"br":1},"ruent in itineribus suis :",{"br":1},"velociter ascendent muros ejus,",{"br":1},"et præparabitur umbraculum.",{"br":1}]}}
{"id":"nam.2.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Portæ fluviorum apertæ sunt,",{"br":1},"et templum ad solum dirutum.",{"br":1}]}}
{"id":"nam.2.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Et miles captivus abductus est,",{"br":1},"et ancillæ ejus minabantur gementes ut columbæ,",{"br":1},"murmurantes in cordibus suis.",{"br":1}]}}
{"id":"nam.2.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Et Ninive quasi piscina aquarum aquæ ejus ;",{"br":1},"ipsi vero fugerunt. State, state !",{"br":1},"et non est qui revertatur.",{"br":1}]}}
{"id":"nam.2.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Diripite argentum, diripite aurum :",{"br":1},"et non est finis divitiarum ex omnibus vasis desiderabilibus.",{"br":1}]}}
{"id":"nam.2.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Dissipata est, et scissa, et dilacerata ;",{"br":1},"et cor tabescens, et dissolutio geniculorum,",{"br":1},"et defectio in cunctis renibus,",{"br":1},"et facies omnium eorum sicut nigredo ollæ.",{"br":1}]}}
{"id":"nam.2.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Ubi est habitaculum leonum,",{"br":1},"et pascua catulorum leonum,",{"br":1},"ad quam ivit leo ut ingrederetur illuc catulus leonis,",{"br":1},"et non est qui exterreat ?",{"br":1}]}}
{"id":"nam.2.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"Leo cepit sufficienter catulis suis,",{"br":1},"et necavit leænis suis,",{"br":1},"et implevit præda speluncas suas,",{"br":1},"et cubile suum rapina.",{"br":1}]}}
{"id":"nam.2.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Ecce ego ad te, dicit Dominus exercituum,",{"br":1},"et succendam usque ad fumum quadrigas tuas,",{"br":1},"et leunculos tuos comedet gladius,",{"br":1},"et exterminabo de terra prædam tuam,",{"br":1},"et non audietur ultra vox nuntiorum tuorum."]}}
{"id":"nam.3","type":"heading","level":2,"label":"Caput 3","t":{"la":["Caput 3"]}}
{"id":"nam.3.1","type":"verse","n":"1","p":true,"t":{"la":[{"num":"1"},"Væ civitas sanguinum,",{"br":1},"universa mendacii dilaceratione plena !",{"br":1},"non recedet a te rapina.",{"br":1}]}}
{"id":"nam.3.2","type":"verse","n":"2","t":{"la":[{"num":"2"},"Vox flagelli, et vox impetus rotæ, et equi frementis,",{"br":1},"et quadrigæ ferventis, et equitis ascendentis,",{"br":1}]}}
{"id":"nam.3.3","type":"verse","n":"3","t":{"la":[{"num":"3"},"et micantis gladii, et fulgurantis hastæ,",{"br":1},"et multitudinis interfectæ, et gravis ruinæ ;",{"br":1},"nec est finis cadaverum,",{"br":1},"et corruent in corporibus suis.",{"br":1}]}}
{"id":"nam.3.4","type":"verse","n":"4","t":{"la":[{"num":"4"},"Propter multitudinem fornicationum meretricis",{"br":1},"speciosæ, et gratæ, et habentis maleficia,",{"br":1},"quæ vendidit gentes in fornicationibus suis,",{"br":1},"et familias in maleficiis suis.",{"br":1}]}}
{"id":"nam.3.5","type":"verse","n":"5","t":{"la":[{"num":"5"},"Ecce ego ad te, dicit Dominus exercituum,",{"br":1},"et revelabo pudenda tua in facie tua ;",{"br":1},"et ostendam gentibus nuditatem tuam,",{"br":1},"et regnis ignominiam tuam.",{"br":1}]}}
{"id":"nam.3.6","type":"verse","n":"6","t":{"la":[{"num":"6"},"Et projiciam super te abominationes,",{"br":1},"et contumeliis te afficiam,",{"br":1},"et ponam te in exemplum.",{"br":1}]}}
{"id":"nam.3.7","type":"verse","n":"7","t":{"la":[{"num":"7"},"Et erit : omnis qui viderit te resiliet a te,",{"br":1},"et dicet : Vastata est Ninive.",{"br":1},"Quis commovebit super te caput ?",{"br":1},"unde quæram consolatorem tibi ?",{"br":1}]}}
{"id":"nam.3.8","type":"verse","n":"8","t":{"la":[{"num":"8"},"Numquid melior es Alexandria populorum,",{"br":1},"quæ habitat in fluminibus ?",{"br":1},"aquæ in circuitu ejus ;",{"br":1},"cujus divitiæ, mare ;",{"br":1},"aquæ, muri ejus.",{"br":1}]}}
{"id":"nam.3.9","type":"verse","n":"9","t":{"la":[{"num":"9"},"Æthiopia fortitudo ejus, et Ægyptus, et non est finis ;",{"br":1},"Africa et Libyes fuerunt in auxilio tuo.",{"br":1}]}}
{"id":"nam.3.10","type":"verse","n":"10","t":{"la":[{"num":"10"},"Sed et ipsa in transmigrationem ducta est in captivitatem :",{"br":1},"parvuli ejus elisi sunt in capite omnium viarum,",{"br":1},"et super inclytos ejus miserunt sortem,",{"br":1},"et omnes optimates ejus confixi sunt in compedibus.",{"br":1}]}}
{"id":"nam.3.11","type":"verse","n":"11","t":{"la":[{"num":"11"},"Et tu ergo inebriaberis, et eris despecta :",{"br":1},"et tu quæres auxilium ab inimico.",{"br":1}]}}
{"id":"nam.3.12","type":"verse","n":"12","t":{"la":[{"num":"12"},"Omnes munitiones tuæ sicut ficus cum grossis suis :",{"br":1},"si concussæ fuerint, cadent in os comedentis.",{"br":1}]}}
{"id":"nam.3.13","type":"verse","n":"13","t":{"la":[{"num":"13"},"Ecce populus tuus mulieres in medio tui :",{"br":1},"inimicis tuis adapertione pandentur portæ terræ tuæ,",{"br":1},"devorabit ignis vectes tuos.",{"br":1}]}}
{"id":"nam.3.14","type":"verse","n":"14","t":{"la":[{"num":"14"},"Aquam propter obsidionem hauri tibi :",{"br":1},"exstrue munitiones tuas,",{"br":1},"intra in lutum, et calca,",{"br":1},"subigens tene laterem.",{"br":1}]}}
{"id":"nam.3.15","type":"verse","n":"15","t":{"la":[{"num":"15"},"Ibi comedet te ignis,",{"br":1},"peribis gladio, devorabit te ut bruchus :",{"br":1},"congregare ut bruchus,",{"br":1},"multiplicare ut locusta.",{"br":1}]}}
{"id":"nam.3.16","type":"verse","n":"16","t":{"la":[{"num":"16"},"Plures fecisti negotiationes tuas quam stellæ sint cæli ;",{"br":1},"bruchus expansus est, et avolavit.",{"br":1}]}}
{"id":"nam.3.17","type":"verse","n":"17","t":{"la":[{"num":"17"},"Custodes tui quasi locustæ,",{"br":1},"et parvuli tui quasi locustæ locustarum,",{"br":1},"quæ considunt in sepibus in die frigoris :",{"br":1},"sol ortus est, et avolaverunt,",{"br":1},"et non est cognitus locus earum ubi fuerint.",{"br":1}]}}
{"id":"nam.3.18","type":"verse","n":"18","t":{"la":[{"num":"18"},"Dormitaverunt pastores tui, rex Assur,",{"br":1},"sepelientur principes tui :",{"br":1},"latitavit populus tuus in montibus,",{"br":1},"et non est qui congreget.",{"br":1}]}}
{"id":"nam.3.19","type":"verse","n":"19","t":{"la":[{"num":"19"},"Non est obscura contritio tua ;",{"br":1},"pessima est plaga tua.",{"br":1},"Omnes qui audierunt auditionem tuam compresserunt manum super te :",{"br":1},"quia super quem non transiit malitia tua semper ?"]}}
