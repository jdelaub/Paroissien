<?xml version="1.0" encoding="utf-8"?>
<!-- ADR 008 (API 29-30) : uniquement le transfert d'un téléphone à l'autre, jamais le nuage. -->
<full-backup-content>
    <include domain="database" path="user.db" requireFlags="deviceToDeviceTransfer" />
    <include domain="database" path="user.db-wal" requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="datastore/" requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
